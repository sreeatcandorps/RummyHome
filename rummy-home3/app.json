{
  "expo": {
    "name": "rummy-home3",
    "slug": "rummy-home3",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rummyhome.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rummyhome.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "rummy-home3",
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
