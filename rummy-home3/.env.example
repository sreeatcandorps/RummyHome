EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: only for local admin scripts (list-users, never ship in the app)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloud builds: push these EXPO_PUBLIC_* values to EAS with
#   npm run eas:env
# See docs/play-store-setup.md
