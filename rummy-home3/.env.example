EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: only for local admin scripts (list-users, never ship in the app)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Passcode-reset page. Must match Supabase Authentication → URL Configuration.
# EXPO_PUBLIC_AUTH_REDIRECT_URL=https://sreeatcandorps.github.io/Games/

# Public scorecard. Defaults to the scorecard edge function on this project.
# EXPO_PUBLIC_SCORECARD_URL=https://gngcrplcldfiubvhcdin.supabase.co/functions/v1/scorecard

# Cloud builds: push these EXPO_PUBLIC_* values to EAS with
#   npm run eas:env
# See docs/play-store-setup.md
