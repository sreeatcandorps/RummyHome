EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: only for local admin scripts (list-users, never ship in the app)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Passcode-reset page. Must match Supabase Authentication → URL Configuration.
# EXPO_PUBLIC_AUTH_REDIRECT_URL=https://sreeatcandorps.github.io/Games/

# Public scorecard. Defaults to the GitHub Pages file.
# EXPO_PUBLIC_SCORECARD_URL=https://sreeatcandorps.github.io/Games/scorecard.html

# Settle stays hidden. Leave this unset. Results is the button on Home.
# EXPO_PUBLIC_SETTLE_ENABLED=true

# Cloud builds: push these EXPO_PUBLIC_* values to EAS with
#   npm run eas:env
# See docs/play-store-setup.md
