  p06 -->|"done"| s06
  s06 --> appearance
  s06 --> emails
  s06 -->|"User settings"| s07
  s07 --> defaults
  defaults -->|"Save"| w31
  w31 --> next
  s06 -->|"Delete account"| p07
  p07 -->|"tick + Delete"| p04
